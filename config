# Pentest Framework — 設定ファイル
#
# run.sh が読み込む。

# ─── 表示モード ──────────────────────────────────────
# split: 同一 tmux ウィンドウ内でペイン分割 (デフォルト)
# tab:   同一 tmux セッション内の別ウィンドウ (タブ切替)
LAYOUT=split

# tmux セッション名
TMUX_SESSION=pentest

# ─── モニタリング ────────────────────────────────────
# 更新間隔 (秒)
MONITOR_INTERVAL=5

# ─── サブエージェント ────────────────────────────────
# 同時に起動するサブエージェントの最大数
# 2026-08-15 ユーザー指示で 3→4 に変更 (監督者変更・本来変更禁止だがユーザー明示許可)
MAX_AGENTS=4

# ─── 推論エフォート ──────────────────────────────────
# Claude Code の effortLevel (low/medium/high)
# Codex の model_reasoning_effort (low/medium/high)
EFFORT=high

# ─── Context Relay (CHAP) ───────────────────────────
# CHAP (NDSS 2026): ~30k 超過で精度劣化が始まる → 構造化 relay で新鮮なコンテキストへ。
# 2段しきい値:
#   ソフト (RELAY_CONTEXT_TOKENS):    チェックポイントのタイミングで超えていたら relay (基本)
#   ハード (RELAY_CONTEXT_HARD_TOKENS): これを超えたら区切りを待たず即 relay (劣化蓄積の保険)
# relay 品質は「区切りで状態が固まっている」ほど高く、ソフトしきい値を基本とする。
RELAY_CONTEXT_TOKENS=30000
RELAY_CONTEXT_HARD_TOKENS=60000
